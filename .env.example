# Database Connection (SQLite for local dev, or PostgreSQL like Neon/Supabase for production)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
AUTH_SECRET="your-generated-random-auth-secret"
NEXTAUTH_SECRET="your-generated-random-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin User Credentials
ADMIN_EMAIL="YourAdminPanel"
ADMIN_PASSWORD="YourSecurePasswordHere"

# YouTube Integration (Optional - Fallbacks to oEmbed + RSS feed)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# Cron Job Secret
CRON_SECRET="your-cron-secret-token"

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
